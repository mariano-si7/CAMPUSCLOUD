#===============================================================
#==========================VARIABLES DE ENTORNO CAMPUSCLOUD
#===============================================================

# POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CampusCloudPostgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_VOLUME=campuscloud-postgres-data

# PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_PASSWORD=adminpassword
PGADMIN_PORT=8082
PGADMIN_VOLUME=campuscloud-pgadmin-data

# SQL SERVER
MSSQL_SA_PASSWORD=sqlserver2026!
SQLSERVER_PORT=1434
MSSQL_PORT=1434
SQLSERVER_VOLUME=campuscloud-sqlserver-data

# MONGODB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CampusCloudMongo2026!
MONGO_INITDB_DATABASE=CampusCloud
MONGO_PORT=27017
MONGO_VOLUME=campuscloud-mongo-data

# DOCKER NETWORK
DOCKER_NETWORK=campuscloud-db-net
