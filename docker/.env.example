#===============================================================
# VARIABLES DE ENTORNO CAMPUSCLOUD - EJEMPLO SIN SECRETOS
# Copiar este archivo como .env y personalizar según el entorno
#===============================================================

# RED DOCKER COMÚN
DOCKER_NETWORK=campuscloud-db-net

# 1. SQL SERVER
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=TuPasswordSeguraSql123!
MSSQL_PORT=1434
SQLSERVER_VOLUME=campuscloud-sqlserver-data

# 2. POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TuPasswordSeguraPostgres#
POSTGRES_DB=CampusCloud
POSTGRES_PORT=5432
POSTGRES_VOLUME=campuscloud-postgres-data

# 3. PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@campuscloud.com
PGADMIN_PASSWORD=TuPasswordSeguraPgAdmin123!
PGADMIN_PORT=8082
PGADMIN_VOLUME=campuscloud-pgadmin-data

# 4. MONGODB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=TuPasswordSeguraMongo2026!
MONGO_DATABASE=CampusCloud
MONGO_PORT=27017
MONGO_VOLUME=campuscloud-mongo-data

# 5. NEO4J
NEO4J_USER=neo4j
NEO4J_PASSWORD=TuPasswordSeguraNeo4j2026!
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_VOLUME=campuscloud-neo4j-data

# 6. APACHE CASSANDRA
CASSANDRA_CLUSTER_NAME=CampusCloudCluster
CASSANDRA_PORT=9042
CASSANDRA_VOLUME=campuscloud-cassandra-data
