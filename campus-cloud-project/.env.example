# SQL SERVER
MSSQL_SA_PASSWORD=CampusCloud123$
MSSQL_PORT=1434
SQLSERVER_VOLUME=campuscloud-sqlserver-data

# NEO4J
NEO4J_PASSWORD=CampusCloudNeo4j2026!
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_VOLUME=campuscloud-neo4j-data

# MONGODB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CampusCloudMongo2026!
