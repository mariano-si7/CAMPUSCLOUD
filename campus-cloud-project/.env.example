# RED DOCKER
DOCKER_NETWORK=campuscloud-db-net

# POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CampusCloudPostgres#
POSTGRES_DB=CampusCloud
POSTGRES_PORT=5432
